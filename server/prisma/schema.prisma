generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  username         String               @unique
  passwordHash     String
  avatarUrl        String?
  subscriptionTier SubscriptionTier     @default(NONE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  memberships      ServerMember[]
  messages         Message[]
  readReceipts     MessageReadReceipt[]
  sentRequests     FriendRequest[]      @relation("sentRequests")
  recvRequests     FriendRequest[]      @relation("receivedRequests")
  sentFriendships  Friendship[]         @relation("friendshipUserA")
  recvFriendships  Friendship[]         @relation("friendshipUserB")
  refreshTokens    RefreshToken[]
  directChannelsA  DirectMessageRoom[]  @relation("dmUserA")
  directChannelsB  DirectMessageRoom[]  @relation("dmUserB")
  directMessages   DirectMessage[]
  boosts           ServerBoost[]
  foxtro           FoxtroSubscription?
  bans             ServerBan[]
}

model FoxtroSubscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  tier      SubscriptionTier
  active    Boolean          @default(true)
  startedAt DateTime         @default(now())
  expiresAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model Server {
  id         String         @id @default(cuid())
  name       String
  iconUrl    String?
  ownerId    String
  inviteCode String         @unique
  channels   Channel[]
  members    ServerMember[]
  boosts     ServerBoost[]
  bans       ServerBan[]
  createdAt  DateTime       @default(now())
}

model ServerBoost {
  id        String   @id @default(cuid())
  serverId  String
  userId    String
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}


model ServerBan {
  id        String   @id @default(cuid())
  serverId  String
  userId    String
  reason    String?
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model ServerMember {
  id       String @id @default(cuid())
  userId   String
  serverId String
  role         Role      @default(MEMBER)
  timeoutUntil DateTime?
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

model Channel {
  id         String      @id @default(cuid())
  name       String
  type       ChannelType
  serverId   String
  category   String?
  server     Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages   Message[]
  threads    Thread[]
  createdAt  DateTime    @default(now())
}

model Thread {
  id          String   @id @default(cuid())
  channelId   String
  parentId    String?
  title       String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model Message {
  id         String               @id @default(cuid())
  content    String
  channelId  String
  authorId   String
  editedAt   DateTime?
  pinned     Boolean              @default(false)
  createdAt  DateTime             @default(now())
  channel    Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author     User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions  Reaction[]
  receipts   MessageReadReceipt[]
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([emoji, messageId, userId])
}

model FriendRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  sender     User          @relation("sentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("receivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("friendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("friendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

model DirectMessageRoom {
  id        String          @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime        @default(now())
  userA     User            @relation("dmUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User            @relation("dmUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  DirectMessage[]

  @@unique([userAId, userBId])
}

model DirectMessage {
  id        String            @id @default(cuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime          @default(now())
  room      DirectMessageRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum SubscriptionTier {
  NONE
  FOXTRO
  FULLFOXTRO
}
